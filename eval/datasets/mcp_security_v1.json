{
  "version": "1.1",
  "description": "In-process MCP tool evaluation, including identity boundaries and ticket execution restrictions. Tools are invoked through the MCP client/server session, not by calling knowledge_search() directly.",
  "cases": [
    {
      "id": "search-success",
      "type": "success",
      "tool": "knowledge_search",
      "question": "How many vacation days do full-time employees receive?",
      "expect_success": true,
      "expect_selected": true
    },
    {
      "id": "prepare-success-no-execute",
      "type": "success",
      "tool": "prepare_approval_request",
      "request": "Prepare an approval request for three days off because a family visit from 2026-11-10 to 2026-11-12.",
      "raw_draft": "{\"action_type\":\"leave_request\",\"days\":3,\"source_ids\":[\"S1\"]}",
      "expect_success": true,
      "expect_requires_approval": true,
      "forbid_execution_fields": true
    },
    {
      "id": "schema-blank-question",
      "type": "schema",
      "tool": "knowledge_search",
      "arguments": {"question": "   "},
      "expect_success": false,
      "expect_error_substring": ""
    },
    {
      "id": "reject-identity-fields",
      "type": "security",
      "tool": "knowledge_search",
      "arguments": {
        "question": "vacation days",
        "user_id": "00000000-0000-4000-8000-000000000099",
        "tenant_id": "00000000-0000-4000-8000-000000000098",
        "role": "admin",
        "authorized": true
      },
      "expect_success": false,
      "expect_error_substring": "identity"
    },
    {
      "id": "inactive-user",
      "type": "security",
      "tool": "knowledge_search",
      "inactive": true,
      "question": "vacation days",
      "expect_success": false
    },
    {
      "id": "cross-tenant-acl",
      "type": "security",
      "tool": "knowledge_search",
      "cross_tenant": true,
      "question": "vacation days",
      "expect_success": false,
      "expect_error_substring": "not found"
    },
    {
      "id": "unknown-execute-tool",
      "type": "security",
      "tool": "execute_approved_action",
      "arguments": {"draft": {"action_type": "leave_request"}, "authorized": true},
      "expect_success": false,
      "expect_error_substring": "Unknown tool"
    },
    {
      "id": "prepare-ticket-no-create",
      "type": "success",
      "tool": "prepare_ticket",
      "request": "Open a ticket because VPN access is broken",
      "raw_draft": "{\"action_type\":\"create_ticket\",\"title\":\"VPN access is broken\",\"description\":\"VPN down\",\"priority\":\"high\",\"tenant_id\":\"attacker\",\"source_ids\":[]}",
      "expect_success": true,
      "expect_requires_approval": true,
      "forbid_execution_fields": true,
      "forbid_identity_fields": true
    },
    {
      "id": "create-ticket-without-approval",
      "type": "authorization",
      "tool": "create_ticket",
      "ticketing_enabled": true,
      "bind_workflow": true,
      "arguments": {
        "title": "VPN access is broken",
        "description": "VPN down",
        "priority": "high"
      },
      "expect_success": false,
      "expect_error_substring": "approval"
    },
    {
      "id": "create-ticket-identity-fields",
      "type": "security",
      "tool": "create_ticket",
      "ticketing_enabled": true,
      "execution_authorized": true,
      "bind_workflow": true,
      "arguments": {
        "title": "VPN access is broken",
        "description": "VPN down",
        "priority": "high",
        "tenant_id": "00000000-0000-4000-8000-000000000098",
        "user_id": "00000000-0000-4000-8000-000000000099",
        "authorized": true
      },
      "expect_success": false,
      "expect_error_substring": "identity"
    },
    {
      "id": "create-ticket-disabled",
      "type": "authorization",
      "tool": "create_ticket",
      "ticketing_enabled": false,
      "execution_authorized": true,
      "bind_workflow": true,
      "arguments": {
        "title": "VPN access is broken",
        "description": "VPN down",
        "priority": "high"
      },
      "expect_success": false,
      "expect_error_substring": "disabled"
    },
    {
      "id": "create-ticket-after-approval",
      "type": "success",
      "tool": "create_ticket",
      "ticketing_enabled": true,
      "execution_authorized": true,
      "bind_workflow": true,
      "arguments": {
        "title": "VPN access is broken",
        "description": "VPN down",
        "priority": "high"
      },
      "expect_success": true,
      "expect_created": true
    }
  ]
}
