# Local development only. Copy to .env and never commit .env.
POSTGRES_DB=enterprise_ai
POSTGRES_USER=enterprise_user
POSTGRES_PASSWORD=dev_password_change_me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60
RAG_CONTEXT_CHARS=6000
RAG_MIN_SIMILARITY=0.2
RAG_RETRIEVE_MULTIPLIER=2
AGENT_MAX_STEPS=8
# Retrieval: semantic (pgvector cosine), lexical (PostgreSQL FTS ts_rank_cd, not BM25), or hybrid (RRF).
RETRIEVAL_MODE=hybrid
RRF_K=60
RETRIEVAL_CANDIDATE_POOL=50
# Required for login/token verification. Must be at least 32 characters and must not
# be the placeholder below. Generate a unique local secret; never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Development-only admin bootstrap (CLI). Leave unset during normal API runs.
# BOOTSTRAP_ADMIN_ENABLED=true
# BOOTSTRAP_ADMIN_EMAIL=admin@localhost
# BOOTSTRAP_ADMIN_PASSWORD=
# Tenant used for public self-registration. Must match a row in tenants.
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
# Required only when upgrading a database that already has users/documents/workflows.
# LEGACY_TENANT_ID=
# LEGACY_TENANT_NAME=Legacy
# Verified owners only. JSON object of document UUID -> user UUID.
# LEGACY_DOCUMENT_OWNERS={"11111111-1111-4111-8111-111111111111":"22222222-2222-4222-8222-222222222222"}
# Optional filename map for unique filenames. Unmapped documents stay quarantined.
# LEGACY_DOCUMENT_OWNERS_BY_FILENAME={"vacation_policy.txt":"22222222-2222-4222-8222-222222222222"}
# Do not set LEGACY_DOCUMENT_OWNER_ID; blanket ownership is rejected.
# Observability. JSON logs omit Authorization, tokens, passwords, prompts, and document text.
LOG_JSON=true
# Metrics are disabled by default. Enable for local Prometheus scrapes of /metrics.
METRICS_ENABLED=true
# If set, /metrics requires Authorization: Bearer <token>. Leave empty only on localhost.
# METRICS_TOKEN=
# Isolated pytest database. Must end with _test and must not be enterprise_ai.
# TEST_DATABASE_URL=postgresql+psycopg://enterprise_user:dev_password_change_me@127.0.0.1:5432/enterprise_ai_acl_test
# Optional dedicated benchmark database (never enterprise_ai).
# BENCH_DATABASE_URL=postgresql+psycopg://enterprise_user:dev_password_change_me@127.0.0.1:5432/enterprise_ai_bench_test
# Invite-only registration. When true, POST /auth/register and first-time OIDC
# provisioning require a valid admin invitation for that email.
AUTH_INVITE_ONLY=false
# Optional OIDC authorization-code login. Disabled by default; no bundled IdP.
OIDC_ENABLED=false
# OIDC_ISSUER=https://your-idp.example
# OIDC_CLIENT_ID=enterprise-ai
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://127.0.0.1:8000/auth/oidc/callback
# OIDC_SCOPES=openid email
# OIDC_DISCOVERY_URL=
# Durable document processing jobs (PostgreSQL). No Redis/Celery.
PROCESSING_JOB_MAX_ATTEMPTS=3
PROCESSING_JOB_LEASE_SECONDS=600
PROCESSING_JOB_POLL_SECONDS=1
PROCESSING_JOB_BACKOFF_SECONDS=5
# Local mock helpdesk tickets through MCP. Disabled by default; no vendor API.
TICKETING_ENABLED=false
# Optional hosted OpenAI-compatible eval LLM. Unset means hosted eval is not_run
# and no paid API is called. Retrieval still needs an isolated *_test database.
# EVAL_HOSTED_LLM_BASE_URL=http://127.0.0.1:11434/v1
# EVAL_HOSTED_LLM_MODEL=llama3.2:3b
# EVAL_HOSTED_LLM_API_KEY=
# EVAL_HOSTED_LLM_TIMEOUT_SECONDS=60
